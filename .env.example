# Copy this file to .env and replace the values. The real demo loads .env automatically.
# .env is ignored by Git. Never put a real key in this tracked example file.
OPENAI_API_KEY=replace-with-your-api-key
VERILOG_AGENT_MODEL=replace-with-a-model-id

# Optional: point the SDK at an OpenAI-compatible Responses API endpoint.
# Most providers use a base URL ending in /v1. Do not append /responses here.
# OPENAI_BASE_URL=https://example.invalid/v1
# VERILOG_AGENT_REQUEST_TIMEOUT_SECONDS=120
# VERILOG_AGENT_MAX_OUTPUT_TOKENS=8192
# VERILOG_AGENT_MAX_RETRIES=2
