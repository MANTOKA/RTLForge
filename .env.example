# Copy to .env and supply your own credentials. Never commit .env.
OPENAI_API_KEY=replace-with-your-api-key
# Optional compatible endpoint; leave empty for the provider SDK default.
OPENAI_BASE_URL=
RTLFORGE_MODEL=replace-with-a-supported-model
RTLFORGE_API_STYLE=responses
# For Chat Completions endpoints, use chat_completions instead.
RTLFORGE_MAX_OUTPUT_TOKENS=32768
RTLFORGE_REQUEST_TIMEOUT_SECONDS=120
RTLFORGE_MAX_RETRIES=2
RTLFORGE_TEMPERATURE=0.1
RTLFORGE_TOP_P=1.0
RTLFORGE_SEED=20261008
